{
  "name": "ofc-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:preview": "STORYBLOK_PREVIEW=1 astro dev --background",
    "build": "astro build",
    "check": "astro check",
    "test": "node --test src/lib/*.test.ts",
    "schema:validate": "storyblok schema validate src/schema/schema.ts",
    "schema:push": "node scripts/storyblok-cli.mjs schema push src/schema/schema.ts",
    "cms:seed": "node scripts/seed-storyblok.mjs",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/libre-baskerville": "^5.3.0",
    "@storyblok/astro": "^10.3.2",
    "@storyblok/schema": "^0.5.0",
    "astro": "^7.3.6"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "storyblok": "^4.23.4",
    "typescript": "^6.0.3"
  }
}
