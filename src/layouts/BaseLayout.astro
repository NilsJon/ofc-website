---
import '../styles/global.css';
import { site } from '../lib/temporary-site';

interface Props {
  title: string;
  description: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://ofc-website.nils-stridbeck.workers.dev/');
const fullTitle = title === site.name ? title : `${title} | ${site.name}`;
const nav = [
  ['/', 'Start'],
  ['/foreningen/', 'Föreningen'],
  ['/magasinen/', 'Magasinen'],
];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ef" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={new URL(image, canonical).href} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label={`${site.name}, startsida`}><span class="station-wordmark">STATION<br />SMEDSTORP</span></a>
        <nav class="desktop-nav" aria-label="Huvudmeny">
          {nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>Meny <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobilmeny">{nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid temporary-footer">
        <div><p class="eyebrow">Smedstorp / Österlen</p><p class="footer-statement">En mötesplats<br />tar form.</p></div>
        <div><p class="eyebrow">Kontakt</p><p><a href={`mailto:${site.email}`}>{site.email}</a></p><a href="/foreningen/">Om föreningen ↗</a></div>
      </div>
      <div class="shell footer-identity"><p><strong>STATION SMEDSTORP</strong>, org.nr. {site.organisationNumber} är en <strong>ideell oberoende kulturförening</strong> {site.associationStatement}</p></div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} {site.name}</span></div>
    </footer>
  </body>
</html>
