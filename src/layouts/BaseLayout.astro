---
import '../styles/global.css';
import type { SiteSettings } from '../lib/content';

interface Props {
  title: string;
  description: string;
  settings: SiteSettings;
  image?: string;
}

const { title, description, settings, image } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://xn--fc-eka.se/');
const fullTitle = title === 'Österlens Fotograficentrum' ? title : `${title} | Österlens Fotograficentrum`;
const nav = [
  ['/', 'Aktuellt'],
  ['/utstallningar/', 'Utställningar'],
  ['/arkiv/', 'Arkiv'],
  ['/om-ofc/', 'Om ÖFC'],
  ['/besok/', 'Besök oss'],
];
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f3ef" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {image && <meta property="og:image" content={new URL(image, canonical).href} />}
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Hoppa till innehåll</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="wordmark" href="/" aria-label="Österlens Fotograficentrum, startsida"><span>Ö<span class="wordmark-dot">·</span>FC</span><small>Österlens<br />Fotograficentrum</small></a>
        <nav class="desktop-nav" aria-label="Huvudmeny">
          {nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}
        </nav>
        <details class="mobile-nav">
          <summary>Meny <span aria-hidden="true">☰</span></summary>
          <nav aria-label="Mobilmeny">{nav.map(([href, label]) => <a href={href} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>)}</nav>
        </details>
      </div>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div><p class="eyebrow">ÖFC / Smedstorp</p><p class="footer-statement">En plats för fotografi<br />på Österlen.</p></div>
        <div><p class="eyebrow">Besök</p><p>{settings.address}</p><a href="/besok/">Hitta hit ↗</a></div>
        <div><p class="eyebrow">Kontakt</p><p><a href={`mailto:${settings.email}`}>{settings.email}</a><br /><a href={`tel:${settings.phone?.replace(/\s/g, '')}`}>{settings.phone}</a></p>{settings.instagram_url && <a href={settings.instagram_url} target="_blank" rel="noopener noreferrer">Instagram ↗</a>}</div>
      </div>
      <div class="shell footer-bottom"><span>© {new Date().getFullYear()} Österlens Fotograficentrum</span><span>Fotografi i Smedstorps Sädesmagasin</span></div>
    </footer>
  </body>
</html>
