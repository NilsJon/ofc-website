---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExhibitionCard from '../../components/ExhibitionCard.astro';
import { classifyExhibition, getExhibitions, getSettings, sortExhibitions } from '../../lib/content';
const settings = await getSettings();
const stories = sortExhibitions(await getExhibitions());
const current = stories.filter((story) => classifyExhibition(story.content) === 'current');
const upcoming = stories.filter((story) => classifyExhibition(story.content) === 'upcoming').reverse();
---
<BaseLayout title="Utställningar" description="Aktuella och kommande fotoutställningar på Österlens Fotograficentrum." settings={settings}>
  <div class="shell page-heading"><p class="eyebrow">Program</p><h1>Utställningar</h1><p>Upptäck fotografi i Smedstorps Sädesmagasin. Datum avgör automatiskt vad som visas som aktuellt och kommande.</p></div>
  <div class="shell spacer-bottom"><section class="section"><div class="section-heading"><h2>Just nu</h2></div>{current.length ? <div class="exhibition-grid">{current.map((story) => <ExhibitionCard story={story} label="Pågår" />)}</div> : <p class="empty-note">Ingen pågående utställning med publicerade datum just nu. Följ oss gärna för kommande program.</p>}</section><section class="section"><div class="section-heading"><h2>Kommande</h2></div>{upcoming.length ? <div class="exhibition-grid">{upcoming.map((story) => <ExhibitionCard story={story} label="Kommande" />)}</div> : <p class="empty-note">Inga kommande datum är publicerade ännu.</p>}</section><a class="text-link" href="/arkiv/">Se arkivet ↗</a></div>
</BaseLayout>
