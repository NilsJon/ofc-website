---
import { getPayload, storyblokEditable } from '@storyblok/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RichText from '../../components/RichText.astro';
import { formatDateRange, getExhibitions, getSettings, getStory, imageSrcset, imageUrl, type CmsStory, type Exhibition } from '../../lib/content';

export const prerender = process.env.STORYBLOK_PREVIEW !== '1';

export async function getStaticPaths() {
  const stories = await getExhibitions();
  return stories.map((story) => ({ params: { slug: story.slug }, props: { story } }));
}

interface Props { story?: CmsStory<Exhibition>; }
const payload = import.meta.env.STORYBLOK_PREVIEW === '1' ? await getPayload({ locals: Astro.locals }) : null;
const story = (payload?.story as CmsStory<Exhibition> | undefined) ?? Astro.props.story ?? await getStory<Exhibition>(`utstallningar/${Astro.params.slug}`);
if (!story) return Astro.redirect('/404/');
const settings = await getSettings();
const { content } = story;
const dateRange = formatDateRange(content.start_date, content.end_date);
const hero = imageUrl(content.hero_image, 1200);
---
<BaseLayout title={content.title} description={content.summary || `${content.title}${content.artists ? ` av ${content.artists}` : ''} på Österlens Fotograficentrum.`} settings={settings} image={hero}>
  <article class="shell spacer-bottom" {...storyblokEditable(content)}>
    <div class="article-grid"><div><p class="eyebrow">Utställning / ÖFC</p><h1>{content.title}</h1>{content.artists && <p class="lead">{content.artists}</p>}{content.summary && <p>{content.summary}</p>}<dl class="meta-list">{dateRange && <div><dt>Datum</dt><dd>{dateRange}</dd></div>}{content.opening_date && <div><dt>Vernissage</dt><dd>{content.opening_date}</dd></div>}<div><dt>Plats</dt><dd>Smedstorps Sädesmagasin</dd></div></dl></div>{hero && <figure class="article-image"><img src={hero} srcset={imageSrcset(content.hero_image)} sizes="(max-width: 640px) 100vw, 55vw" width={content.hero_image?.width ?? 1200} height={content.hero_image?.height ?? 900} alt={content.hero_image?.alt ?? ''} />{content.image_credit && <figcaption>Foto: {content.image_credit}</figcaption>}</figure>}</div>
    {content.body && <section class="section"><RichText document={content.body} /></section>}
    {content.gallery?.length && <section class="section"><div class="section-heading"><h2>Bilder</h2></div><div class="gallery">{content.gallery.map((item) => item.image?.filename && <figure {...storyblokEditable(item)}><img src={imageUrl(item.image, 1000)} srcset={imageSrcset(item.image)} sizes="(max-width: 640px) 100vw, 45vw" width={item.image.width ?? 1000} height={item.image.height ?? 750} alt={item.image.alt ?? ''} loading="lazy" />{(item.caption || item.credit) && <figcaption>{item.caption}{item.caption && item.credit ? ' · ' : ''}{item.credit}</figcaption>}</figure>)}</div></section>}
    {content.external_url && <p><a class="text-link" href={content.external_url} target="_blank" rel="noopener noreferrer">Mer information ↗</a></p>}
    <a class="back-link" href="/utstallningar/">← Alla utställningar</a>
  </article>
</BaseLayout>
