---
import { getPayload, storyblokEditable } from '@storyblok/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ExhibitionCard from '../../components/ExhibitionCard.astro';
import { classifyExhibition, getArchiveEntries, getExhibitions, getSettings, imageUrl, sortExhibitions, type ArchiveEntry, type CmsStory } from '../../lib/content';
import legacyNames from '../../../data/legacy-exhibitors.json';
import listed2026 from '../../../data/listed-2026.json';

const settings = await getSettings();
const archived = sortExhibitions(await getExhibitions()).filter((story) => classifyExhibition(story.content) === 'archived');
const cmsEntries = await getArchiveEntries();
const payload = import.meta.env.STORYBLOK_PREVIEW === '1' ? await getPayload({ locals: Astro.locals }) : null;
const previewStory = payload?.story as CmsStory<ArchiveEntry> | undefined;
if (previewStory?.content?.component === 'archive_entry') {
  const index = cmsEntries.findIndex((story) => story.full_slug === previewStory.full_slug);
  if (index >= 0) cmsEntries[index] = previewStory;
  else cmsEntries.push(previewStory);
}
const entries: ArchiveEntry[] = cmsEntries.length ? cmsEntries.map((story) => story.content) : [
  ...listed2026.map((artist) => ({ component: 'archive_entry' as const, artist, year: '2026' })),
  ...legacyNames.map((artist) => ({ component: 'archive_entry' as const, artist, year: '' })),
];
const groups = Object.groupBy(entries, (entry) => entry.year || 'År saknas');
const years = Object.keys(groups).sort((a, b) => b.localeCompare(a, 'sv-SE'));
---
<BaseLayout title="Arkiv" description="Tidigare utställningar och utställare på Österlens Fotograficentrum." settings={settings}>
  <div class="shell page-heading">
    <p class="eyebrow">ÖFC genom åren</p>
    <h1>Arkiv</h1>
    <p>Ett växande arkiv över utställningar och fotografer som visats här. Äldre namn bevaras även när datum och bilder ännu saknas.</p>
  </div>
  <div class="shell spacer-bottom">
    {archived.length > 0 && <section class="section">
      <div class="section-heading"><h2>Tidigare utställningar</h2></div>
      <div class="exhibition-grid">{archived.map((story) => <ExhibitionCard story={story} />)}</div>
    </section>}
    <section class="section">
      <div class="section-heading"><h2>Utställare och namn</h2></div>
      <p class="note">Namn från den tidigare webbplatsen. Listan för 2026 har inga exakta datum eller titlar och är därför inte ett verifierat utställningsprogram.</p>
      <div class="archive-list">
        {years.map((year) => <div class="archive-year">
          <h2>{year === '2026' ? 'Listade 2026' : year}</h2>
          <ul>{groups[year]?.map((entry) => <li {...storyblokEditable(entry)}>
            {entry.image?.filename && <img class="archive-thumb" src={imageUrl(entry.image, 240)} width={entry.image.width ?? 240} height={entry.image.height ?? 180} alt={entry.image.alt ?? ''} loading="lazy" />}
            {entry.artist}{entry.title ? ` · ${entry.title}` : ''}
          </li>)}</ul>
        </div>)}
      </div>
    </section>
  </div>
</BaseLayout>
