---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../lib/temporary-site';
---

<BaseLayout title={site.name} description="Föreningen verkar för att bevara och utveckla magasinsbyggnaderna i Smedstorp till en hållbar mötesplats för mat, kultur och konst." image="/images/station-smedstorp-spar.jpeg">
  <section class="hero">
    <div class="hero-image"><img src="/images/station-smedstorp-spar.jpeg" width="1039" height="1386" alt="Järnvägsspår och kontaktledningar i solnedgång" fetchpriority="high" /></div>
    <div class="hero-copy">
      <div><p class="eyebrow">Station Smedstorp / Österlen</p><h1>En mötesplats tar form.</h1><p>Vi vill ta vara på magasinsbyggnaderna i Smedstorp och utveckla dem varsamt för framtiden.</p></div>
      <a class="hero-link" href="/foreningen/">Läs om föreningen ↗</a>
    </div>
  </section>
  <div class="shell info-strip">
    <div><p class="eyebrow">Platsen</p><p>Magasinsbyggnaderna i Smedstorp</p></div>
    <div><p class="eyebrow">Inriktning</p><p>Mat · Kultur · Konst</p></div>
    <div><p class="eyebrow">Målet</p><p>En hållbar mötesplats för företag och organisationer</p></div>
  </div>
  <section class="shell section intro-grid"><div><p class="eyebrow">Vår idé</p><p class="lead">Varsam renovering. Nya möjligheter.</p></div><div><p>Föreningen arbetar för att byggnaderna ska tas till vara, renoveras och utvecklas till en plats där olika verksamheter kan mötas.</p><p>Här vill vi skapa utrymme för innovationer och verksamhet kring mat, kultur och konst.</p><a class="text-link" href="/foreningen/">Föreningens ändamål ↗</a></div></section>
  <section class="shell section"><div class="section-heading"><h2>Magasinen</h2><a href="/magasinen/">Läs mer ↗</a></div><p class="lead">En del av Smedstorps historia, med plats för en ny framtid.</p></section>
</BaseLayout>
