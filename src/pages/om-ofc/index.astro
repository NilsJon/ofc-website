---
import { getPayload, storyblokEditable } from '@storyblok/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import RichText from '../../components/RichText.astro';
import { getSettings, getStory, imageSrcset, imageUrl, type AboutContent, type CmsStory } from '../../lib/content';
const payload = import.meta.env.STORYBLOK_PREVIEW === '1' ? await getPayload({ locals: Astro.locals }) : null;
const about = (payload?.story as CmsStory<AboutContent> | undefined) ?? await getStory<AboutContent>('om-ofc');
const settings = await getSettings();
const image = imageUrl(about?.content.image, 1400) ?? '/images/sadesmagasinet-ritning.jpg';
---
<BaseLayout title="Om ÖFC" description="Om Österlens Fotograficentrum och Smedstorps Sädesmagasin." settings={settings} image={image}>
  <div class="shell page-heading" {...(about?.content ? storyblokEditable(about.content) : {})}><p class="eyebrow">Platsen och tanken</p><h1>Om ÖFC</h1><p>{about?.content.introduction ?? 'Här på Österlen har vi utvecklat en plats för fotografi där du kan se, uppleva och ta del av fotografi och samtidigt möta fotograferna bakom bilderna.'}</p></div>
  <div class="shell spacer-bottom"><section class="section intro-grid"><div><p class="eyebrow">Österlens Fotograficentrum</p><p class="lead">En stillsam, fysisk plats för fotografi.</p></div><div>{about?.content.background ? <RichText document={about.content.background} /> : <div class="prose"><p>Vi vill skapa en plats där fotografiet kan upplevas, undersökas och utvecklas. Fotografiet rymmer angelägna betraktelser om oss själva, vår tid och vår värld.</p><p>Tanken är att skapa en arena för ett samtida undersökande av bild, film och foto.</p></div>}</div></section><section class="section"><div class="section-heading"><h2>Smedstorps Sädesmagasin</h2></div><div class="intro-grid"><p class="lead">Ett magasin med historia, mitt på Österlen.</p><div>{about?.content.building ? <RichText document={about.content.building} /> : <div class="prose"><p>Platsen är Smedstorps Sädesmagasin, en bruksbyggnad från slutet av 1800-talet. Magasinet har renoverats varsamt med lokala material och små fotavtryck.</p></div>}</div></div><figure class="building-image"><img src={image} srcset={about?.content.image ? imageSrcset(about.content.image) : undefined} sizes="100vw" width={about?.content.image?.width ?? 1910} height={about?.content.image?.height ?? 806} alt={about?.content.image?.alt ?? 'Ritning av Smedstorps Sädesmagasin'} loading="lazy" /></figure></section></div>
</BaseLayout>
